---
// Starlight's footer plus a cookie consent banner and a "Cookie settings" link.
// The consent defaults and the Tag Manager loader are in the <head> (see astro.config.mjs).
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />

<p class="cookie-settings-row">
	<button type="button" class="cookie-settings-link" data-cookie-settings>Cookie settings</button>
</p>

<div class="cookie-banner" role="region" aria-label="Cookie consent" hidden data-cookie-banner>
	<p>
		We use Google Analytics cookies to count visits and see which pages are useful. Nothing
		is set unless you accept, and you can change your mind any time from the "Cookie
		settings" link at the bottom of each page.
	</p>
	<div class="cookie-banner-actions">
		<button type="button" data-cookie-choice="denied">Reject</button>
		<button type="button" data-cookie-choice="granted">Accept</button>
	</div>
</div>

<script>
	const STORAGE_KEY = 'optio-cookie-consent';
	const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

	function readChoice(): string | null {
		try {
			return localStorage.getItem(STORAGE_KEY);
		} catch {
			return null;
		}
	}

	function saveChoice(choice: string) {
		try {
			localStorage.setItem(STORAGE_KEY, choice);
		} catch {
			// Storage blocked: the choice applies to this page only.
		}
	}

	// Remove the Google Analytics cookies (_ga, _ga_<id>) after a visitor withdraws consent.
	function clearAnalyticsCookies() {
		const host = location.hostname;
		const domains = ['', host, '.' + host, '.' + host.split('.').slice(-2).join('.')];
		for (const cookie of document.cookie.split(';')) {
			const name = cookie.split('=')[0].trim();
			if (name === '_ga' || name.startsWith('_ga_')) {
				for (const domain of domains) {
					document.cookie = `${name}=; Max-Age=0; path=/${domain ? '; domain=' + domain : ''}`;
				}
			}
		}
	}

	if (banner && readChoice() === null) banner.hidden = false;

	document.querySelectorAll<HTMLButtonElement>('[data-cookie-choice]').forEach((button) => {
		button.addEventListener('click', () => {
			const choice = button.dataset.cookieChoice!;
			const previous = readChoice();
			saveChoice(choice);
			if (banner) banner.hidden = true;
			if (choice === 'granted') {
				window.optioLoadAnalytics?.();
			} else if (previous === 'granted' || window.optioGtmLoaded) {
				window.gtag?.('consent', 'update', { analytics_storage: 'denied' });
				clearAnalyticsCookies();
				// Reload so Tag Manager is no longer running on this page.
				location.reload();
			}
		});
	});

	document.querySelector('[data-cookie-settings]')?.addEventListener('click', () => {
		if (banner) {
			banner.hidden = false;
			banner.querySelector<HTMLButtonElement>('button')?.focus();
		}
	});

	declare global {
		interface Window {
			optioLoadAnalytics?: () => void;
			optioGtmLoaded?: boolean;
			gtag?: (...args: unknown[]) => void;
		}
	}
</script>

<style>
	.cookie-settings-row {
		margin-top: 1.5rem;
	}

	.cookie-settings-link {
		background: none;
		border: 0;
		padding: 0;
		font: inherit;
		font-size: 1rem;
		color: var(--sl-color-gray-3);
		text-decoration: underline;
		cursor: pointer;
	}

	.cookie-settings-link:hover {
		color: var(--sl-color-white);
	}

	.cookie-banner {
		position: fixed;
		inset-inline: 1rem;
		bottom: 1rem;
		z-index: 100;
		max-width: 40rem;
		margin-inline: auto;
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-text);
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.5rem;
		box-shadow: var(--sl-shadow-lg);
		font-size: 1rem;
		line-height: 1.5;
	}

	.cookie-banner[hidden] {
		display: none;
	}

	.cookie-banner p {
		margin: 0;
	}

	.cookie-banner-actions {
		display: flex;
		gap: 0.75rem;
		justify-content: flex-end;
		flex-wrap: wrap;
	}

	/* Accept and Reject look the same, so neither is the easier choice. */
	.cookie-banner-actions button {
		min-width: 7rem;
		padding: 0.6rem 1.25rem;
		font: inherit;
		font-size: 1rem;
		font-weight: 600;
		color: var(--sl-color-text-invert);
		background: var(--sl-color-text-accent);
		border: 0;
		border-radius: 999rem;
		cursor: pointer;
	}

	.cookie-banner-actions button:hover {
		background: var(--sl-color-white);
	}
</style>
